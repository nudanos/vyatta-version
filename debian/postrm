#!/bin/sh

set -e

PKG=vyatta-version

case "$1" in
    purge|remove|abort-install|disappear)
	# The link to our file is made by preinst; remove it, then the
	# diversion (which renames base-files-vyatta's file back if present).
	# Not on upgrade: the new preinst has already made both, and nothing
	# would make them again.
	if [ -L /etc/os-release.vyatta ] ; then
	    rm -f /etc/os-release.vyatta
	fi
	if [ "$(dpkg-divert --listpackage /etc/os-release.vyatta)" = "${PKG}" ] ; then
	    dpkg-divert --package ${PKG} --remove --rename \
		--divert /etc/os-release.base-files-vyatta \
		/etc/os-release.vyatta
	fi
	;;

    upgrade|failed-upgrade|abort-upgrade)
	;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
	;;
esac

#DEBHELPER#

exit 0
